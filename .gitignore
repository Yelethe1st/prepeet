# Locally installed code generators
.tools/

# The tool binaries, when somebody builds one in place.
#
# All three were tracked: ten megabytes of compiled darwin executables, rebuilt
# and re-committed on every change, and useless to CI, which runs Linux. The
# Makefile builds each into .tools/ when it needs one, so nothing ever read the
# copies in the tree.
tools/apicompat/apicompat
tools/authzgen/authzgen
tools/eventgen/eventgen

# The pnpm store, if a containerised run puts one here.
.pnpm-store/

# Agent worktrees. Transient, and each is a git repository of its own.
.claude/worktrees/

# Per-run timing from the evaluation harness. The report itself is tracked,
# because QUA-04 gates publication on it and a gate cannot read a file a
# clean checkout does not have; timing is what would dirty the tree on every
# run, so it is written beside the report rather than into it.
services/intelligence/evals/reports/latest.timing.json
