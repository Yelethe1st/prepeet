# Host ports for the local stack. Copy to .env and change anything that clashes
# with something already running on your machine.
#
# The container-side ports never change, so nothing inside the stack cares what
# you pick here. Only your own connection strings do.

PREPEET_POSTGRES_PORT=5432
PREPEET_MINIO_PORT=9000
PREPEET_MINIO_CONSOLE_PORT=9001
PREPEET_TEMPORAL_PORT=7233
PREPEET_TEMPORAL_UI_PORT=8233
